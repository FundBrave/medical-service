# ── Contract addresses (fill in after running: cd contracts && npm run deploy:testnet) ──
NEXT_PUBLIC_CAMPAIGN_ADDRESS=0x...
NEXT_PUBLIC_STAKING_ADDRESS=0x...
NEXT_PUBLIC_CCTP_RECEIVER_ADDRESS=0x...

# ── USDC on Base Sepolia (FundBrave mock — already set as fallback, but explicit is safer) ──
NEXT_PUBLIC_USDC_ADDRESS=0xf269f54304f8DB2dB613341CC7E189B02BEf98dE

# ── Testnet token addresses (Base Sepolia) ──
NEXT_PUBLIC_DAI_ADDRESS=0xD5F45AE6088fE7DadA621C8A70F94abE3F46f7Bf
