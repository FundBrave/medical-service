# ── Deployer ──────────────────────────────────────────────────────────────────
PRIVATE_KEY=0x...                            # Deployer wallet private key (never commit!)
ALCHEMY_API_KEY=                             # Alchemy API key (optional, for RPC)
BASESCAN_API_KEY=                            # Basescan API key for contract verification

# ── Treasury ──────────────────────────────────────────────────────────────────
TREASURY_MULTISIG=0x...                      # Gnosis Safe multisig address for the family
PLATFORM_WALLET=0x...                        # FundBrave platform wallet (optional, default=deployer)

# ── Watcher (Paystack fiat float wallet) ──────────────────────────────────────
WATCHER_ADDRESS=0x...                        # Hot wallet that calls donateUSDCFor() for fiat payments
                                             # Must hold USDC on Base and approve campaign at max uint256

# ── Optional overrides ────────────────────────────────────────────────────────
BRIDGE_ADDRESS=                              # FundBraveBridge on Base (leave empty on first deploy)
MAINNET_SWAP_ADAPTER=                        # Pre-deployed UniswapAdapterUSDC (leave empty to deploy new)
USDC_ADDRESS=                                # Override USDC address (auto-set by chain config)
